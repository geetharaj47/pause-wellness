ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# Primary database connection string (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5434/pause_wellness
# Fallback database connection string (SQLite for offline testing)
DATABASE_URL_FALLBACK=sqlite+aiosqlite:///./pause.db
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Base64-encoded 32-byte Fernet key for encrypting journal text at rest
PAUSE_JOURNAL_ENCRYPTION_KEY=replace_with_fernet_generated_key
# External model provider sharing (default false per specification)
ENABLE_EXTERNAL_MODEL_PROVIDER=false
