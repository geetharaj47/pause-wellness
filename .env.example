# MindTrace Configuration Example
# Copy this file to .env and configure the variables.

# Environment configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database
# Local SQLite fallback (default): sqlite+aiosqlite:///./mindtrace.db
# PostgreSQL syntax: postgresql+asyncpg://user:password@localhost:5432/mindtrace
DATABASE_URL=sqlite+aiosqlite:///./mindtrace.db

# JWT Authentication
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=supersecretjwtkeyreplaceinproduction1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
